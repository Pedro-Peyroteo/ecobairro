# Build Stage
FROM node:20-alpine AS builder

RUN corepack enable
WORKDIR /workspace

# Copy root configs
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/ ./packages/
COPY apps/api/package.json ./apps/api/

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy app source
COPY apps/api/ ./apps/api/

# Build app
RUN pnpm --filter @ecobairro/api build

# Production Stage
FROM node:20-alpine

RUN corepack enable
WORKDIR /app

# Copy built files and node_modules from builder
COPY --from=builder /workspace/node_modules ./node_modules
COPY --from=builder /workspace/apps/api/node_modules ./apps/api/node_modules
COPY --from=builder /workspace/apps/api/dist ./dist
COPY --from=builder /workspace/apps/api/package.json ./package.json
COPY --from=builder /workspace/apps/api/prisma ./prisma

ENV NODE_ENV=production
EXPOSE 3000

CMD ["pnpm", "start:prod"]
