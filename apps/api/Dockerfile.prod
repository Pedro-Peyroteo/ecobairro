# Build Stage
FROM node:22-alpine AS builder

RUN corepack enable
WORKDIR /workspace

# Copy root configs
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/ ./packages/
COPY apps/api/package.json ./apps/api/

# Install all dependencies
RUN pnpm install --frozen-lockfile

# Copy app source and prisma schema
COPY apps/api/ ./apps/api/

# Generate Prisma Client
RUN pnpm --filter @ecobairro/api exec prisma generate

# Build app
RUN pnpm --filter @ecobairro/api build

# Deploy stage: cria pasta self-contained sem symlinks do pnpm
RUN pnpm --filter @ecobairro/api deploy --prod --legacy /deploy

# Copy built dist (deploy only copies prod deps, not the build output)
RUN cp -r /workspace/apps/api/dist /deploy/dist

# Production Stage
FROM node:22-alpine

WORKDIR /app
COPY --from=builder /deploy .

ENV NODE_ENV=production
EXPOSE 3000

CMD ["node", "dist/main.js"]
